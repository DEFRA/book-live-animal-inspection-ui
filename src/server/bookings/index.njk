{% extends 'layouts/page.njk' %}
{% set displayBacklink = true %}

{% block content %}
  {% call appPageBody() %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <form action="/upcomingBookings" method="get">
        {% from "govuk/components/table/macro.njk" import govukTable %}
          {{ govukTable({
            caption: "Your upcoming inspections",
            captionClasses: "govuk-heading-l",
            firstCellIsHeader: true,
            head: [
              { text: "Reference number" },
              { text: "Date and time"},
              { text: "Vehicle type"},
              { text: "Summary"},
              { text: "Change"},
              { text: "Cancel"}
          ],
          rows: data
        }) }}
          </form>
        </div>
      </div>
      {% endcall %}
    {% endblock %}