{% extends 'layouts/page.njk' %}
{% set displayBacklink = true %}

{% block content %}
  {% call appPageBody() %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form action="/inspectionDate" method="post">

         {% if error %}
           {% set errorMessage = { text: error } %}
          {% set errorClass = 'govuk-input--error' %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: error,
              href: "#"
            }
          ]
        }) }} 
       {% else %}
          {% set errorMessage = null %}
       {% endif %}
          {{ govukRadios({
          name: "inspectionDateOption",
          value: inspectionDateOption,
          fieldset: {
            legend: {
              text: "Choose an inspection date",
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l " ~ errorClass
            }
          },
          items: inspectionDateOptions,
          errorMessage: errorMessage
        }) }}

        {{ govukButton({
          text: "Save and continue"
        }) }}
      </form>
    </div>
  </div>
  {% endcall %}
{% endblock %}

