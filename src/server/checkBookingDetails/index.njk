{% extends 'layouts/page.njk' %}
{% set displayBacklink = true %}

{% block content %}
  {% call appPageBody() %}
      <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

      <h1 class="govuk-heading-xl">
        Check your answers
      </h1>

      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Border control post"
            },
            value: {
              text: bookingSelectedParameters.location
            },
            actions: {
              items: [
                {
                  href: "location",
                  text: "",
                  visuallyHiddenText: "Border control post"
                }
              ]
            }
          }
          ,
          {
            key: {
              text: "Vehicle type"
            },
            value: {
              text: bookingSelectedParameters.vehicleTypeOption
            },
            actions: {
              items: [
                {
                  href: "vehicleDetails?route=checkBookingDetails",
                  text: "Change",
                  visuallyHiddenText: "Type of vehicle"
                }
              ]
            }
          }
          ,
          {
            key: {
              text: "Vehicle unloading type"
            },
            value: {
              text: bookingSelectedParameters.unloadTypeOption
            },
            actions: {
              items: [
                {
                  href: "vehicleUnloadType?route=checkBookingDetails",
                  text: "Change",
                  visuallyHiddenText: "Vehicle unloading type"
                }
              ]
            }
          }
          ,
          {
            key: {
              text: "Animal species "
            },
            value: {
              text: bookingSelectedParameters.animalSpecies
            },
            actions: {
              items: [
                {
                  href: "animalSelection?route=checkBookingDetails",
                  text: "Change",
                  visuallyHiddenText: "Animal species"
                }
              ]
            }
          },
           {
            key: {
              text: "Number of animals"
            },
            value: {
              text: bookingSelectedParameters.animalCount
            },
            actions: {
              items: [
                {
                  href: "animalCount?route=checkBookingDetails",
                  text: "Change",
                  visuallyHiddenText: "Number of animals"
                }
              ]
            }
          },
           {
            key: {
              text: "Time and date"
            },
            value: {
              text: bookingSelectedParameters.arrivalDate
            },
            actions: {
              items: [
                {
                  href: "arrivalDate?route=checkBookingDetails",
                  text: "Change",
                  visuallyHiddenText: "Time and date"
                }
              ]
            }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">
        Now, book your inspection
      </h2>

      <p class="govuk-body">
        By doing so, you are confirming that you will not make more bookings than you need. You understand that doing so may result in penalty.
      </p>

      <form action="/confirmation" method="post" novalidate>

        {{ govukButton({
          text: "Accept and book"
        }) }}

      </form>

    </div>
  </div>
      {% endcall %}
    {% endblock %}