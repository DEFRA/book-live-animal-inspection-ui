{% extends 'layouts/page.njk' %}
{% set pageTitle = "Home" %}

{% block pageTitle %}
  Home {{ serviceName }}
{% endblock %}

{% block content %}
  {% call appPageBody() %}
  <form action='' method="get">
    <div class="govuk-grid-row">
      <h1 class="govuk-heading-xl">
        {{ serviceName }}
      </h1>

      <p>You need to book an inspection if you are importing live animals into Great Britain. Inspections take place at these border control posts:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>Sevington, England</li>
        <li>Fishguard, Wales</li>
        <li>Pembroke Dock, Wales</li>
        <li>Holyhead, Wales</li>
      </ul>
      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">Warning</span>
    You must book a separate inspection for each vehicle you are transporting.
  </strong>
      </div>
      <p>To book an inspection, you need to know the:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>Type of vehicle you will use</li>
        <li>Animal species</li>
        <li>Number of animals</li>
        <li>Estimated date of arrival</li>
      </ul>

      {{ govukButton({
        text: "Start now"
      }) }}
    </div>
    {% endcall %}
  {% endblock %}